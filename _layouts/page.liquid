---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>関連論文</h2>
    {% capture related_list %}{% bibliography --cited --group_by none %}{% endcapture %}
    {% if related_list contains '○' %}<p class="pub-note">講演の○は発表者を示します。</p>{% endif %}
    <div class="publications">
      {{ related_list }}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
